{
  "name": "obsidian-research-panel",
  "version": "0.1.0",
  "description": "Side panel that surfaces relevant academic documents for the working note.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.mjs",
    "deploy": "node esbuild.mjs once && node scripts/deploy.mjs",
